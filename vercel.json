{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo Pages are pre-built locally with npm run build",
  "installCommand": "echo No dependencies to install",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/sacred/tirupati-shirdi-sabarimala/",
      "destination": "/sacred/tirupati-balaji/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/((?!css/|js/|search-index\\.json).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/search-index.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.ico|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
